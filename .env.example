# Local development only. Copy to .env (which is gitignored) before migrating.

# Matches the user, password, database, and port in docker-compose.yml.
DATABASE_URL="postgresql://patient:patient@localhost:5432/patient_dashboard"

# Two different 32-byte keys, base64-encoded. They protect Social Security
# numbers at rest. Generate replacements with: openssl rand -base64 32
# Losing the encryption key makes stored values unreadable. The HMAC key
# must stay stable too, or duplicate detection no longer matches old rows.
SSN_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
SSN_HMAC_KEY="ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA="
